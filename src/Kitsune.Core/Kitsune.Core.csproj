<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Kitsune.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\emulator_controller.proto" GrpcServices="Client" ProtoRoot="Protos" />
  </ItemGroup>

</Project>
